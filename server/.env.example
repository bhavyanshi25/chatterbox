# Copy to server/.env and fill in. Never commit the real .env.

# MongoDB connection string (local install, Docker, or MongoDB Atlas).
# Use 127.0.0.1 rather than localhost on Windows — MongoDB often listens on IPv4 only.
MONGODB_URI=mongodb://127.0.0.1:27017/chatterbox

# Secret used to sign login tokens. REQUIRED, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts (jsonwebtoken format, e.g. 7d, 12h).
JWT_EXPIRES_IN=7d

# Port for the API + Socket.IO server.
PORT=4000

# Frontend origin(s) allowed to call the API with cookies (comma-separated).
CLIENT_ORIGIN=http://localhost:5173

# Where uploaded images are stored (relative to server/). Not publicly served.
UPLOAD_DIR=uploads

# Maximum image upload size in megabytes.
MAX_UPLOAD_MB=5

# Set to true to also serve the built frontend (../dist) from this server.
SERVE_CLIENT=false

# development | production | test
NODE_ENV=development
